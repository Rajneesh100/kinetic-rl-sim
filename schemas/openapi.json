  "components": {
    "schemas": {
      "FluidConfig": {
        "properties": {
          "resolution": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 16.0,
            "title": "Resolution",
            "default": 64
          },
          "timestep": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 0.001,
            "title": "Timestep",
            "default": 0.02
          },
          "viscosity": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 0.0,
            "title": "Viscosity",
            "default": 0.0001
          },
          "diffusion": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 0.0,
            "title": "Diffusion",
            "default": 1e-05
          },
          "inflow": {
            "type": "number",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Inflow",
            "default": 0.6
          },
          "dye_source": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Dye Source",
            "default": 2.0
          },
          "source_x": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Source X",
            "default": 0.12
          },
          "source_y": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Source Y",
            "default": 0.5
          },
          "source_radius": {
            "type": "number",
            "maximum": 0.3,
            "minimum": 0.01,
            "title": "Source Radius",
            "default": 0.06
          },
          "source_mode": {
            "type": "string",
            "enum": [
              "jet",
              "rake"
            ],
            "title": "Source Mode",
            "description": "Jet uses the circular source. Rake emits nine horizontal dye stripes near source_x, spanning y=0.1 to 0.9.",
            "default": "jet"
          },
          "dissipation": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Dissipation",
            "default": 0.03
          },
          "obstacle": {
            "type": "boolean",
            "title": "Obstacle",
            "default": true
          },
          "obstacle_x": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.05,
            "title": "Obstacle X",
            "default": 0.45
          },
          "obstacle_y": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.05,
            "title": "Obstacle Y",
            "default": 0.5
          },
          "obstacle_radius": {
            "type": "number",
            "maximum": 0.3,
            "minimum": 0.01,
            "title": "Obstacle Radius",
            "default": 0.1
          },
          "obstacles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FluidObstacle"
                },
                "type": "array",
                "maxItems": 16
              },
              {
                "type": "null"
              }
            ],
            "title": "Obstacles",
            "description": "Explicit obstacle objects. Null uses the legacy circle controls; an empty list creates a clean channel. Each object must occupy at least four grid cell centers and leave the outer cell ring fluid."
          },
          "iterations": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 10.0,
            "title": "Iterations",
            "default": 60
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FluidConfig"
      },
      "FluidObstacle": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "shape": {
            "type": "string",
            "enum": [
              "circle",
              "box",
              "ellipse",
              "naca0012",
              "naca2412",
              "polygon"
            ],
            "title": "Shape",
            "default": "circle"
          },
          "x": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "X",
            "default": 0.45
          },
          "y": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Y",
            "default": 0.5
          },
          "width": {
            "type": "number",
            "maximum": 0.9,
            "minimum": 0.01,
            "title": "Width",
            "description": "Diameter, full box/ellipse width, or airfoil chord in unit-domain coordinates.",
            "default": 0.2
          },
          "height": {
            "type": "number",
            "maximum": 0.9,
            "minimum": 0.01,
            "title": "Height",
            "description": "Full box/ellipse/polygon height. Ignored for circles and fixed 12%-chord NACA profiles.",
            "default": 0.2
          },
          "angle": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Angle",
            "description": "Counterclockwise rotation in degrees about (x,y).",
            "default": 0.0
          },
          "points": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number",
                    "maximum": 0.5,
                    "minimum": -0.5
                  },
                  "type": "array",
                  "maxItems": 2,
                  "minItems": 2
                },
                "type": "array",
                "maxItems": 64,
                "minItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Points",
            "description": "Simple polygon vertices in local [-0.5,0.5] coordinates, scaled by width/height. Do not repeat the first vertex."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "FluidObstacle"
      },
      "FluidStepRequest": {
        "properties": {
          "steps": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Steps",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FluidStepRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObjectConfig": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9 _.-]*$",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "box",
              "sphere",
              "cylinder",
              "capsule"
            ],
            "title": "Kind",
            "default": "box"
          },
          "size": {
            "items": {
              "type": "number",
              "maximum": 1000.0,
              "exclusiveMinimum": 0.0
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Size",
            "description": "MuJoCo sizes: box half-extents; sphere radius=size[0]; cylinder/capsule radius=size[0], half-length=size[1]."
          },
          "position": {
            "items": {
              "type": "number",
              "maximum": 1000000.0,
              "minimum": -1000000.0
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Position"
          },
          "rotation": {
            "items": {
              "type": "number",
              "maximum": 1000000.0,
              "minimum": -1000000.0
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Rotation",
            "description": "XYZ Euler angles, radians."
          },
          "mass": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.001,
            "title": "Mass",
            "default": 1.0
          },
          "static": {
            "type": "boolean",
            "title": "Static",
            "default": false
          },
          "color": {
            "items": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Color"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ObjectConfig"
      },
      "PhysicsConfig": {
        "properties": {
          "gravity": {
            "items": {
              "type": "number",
              "maximum": 1000000.0,
              "minimum": -1000000.0
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Gravity"
          },
          "timestep": {
            "type": "number",
            "maximum": 0.02,
            "minimum": 0.0001,
            "title": "Timestep",
            "default": 0.005
          },
          "substeps": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Substeps",
            "default": 4
          },
          "iterations": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Iterations",
            "default": 50
          },
          "integrator": {
            "type": "string",
            "enum": [
              "implicitfast",
              "Euler",
              "RK4",
              "implicit"
            ],
            "title": "Integrator",
            "default": "implicitfast"
          },
          "solver": {
            "type": "string",
            "enum": [
              "Newton",
              "CG",
              "PGS"
            ],
            "title": "Solver",
            "default": "Newton"
          },
          "tolerance": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 1e-12,
            "title": "Tolerance",
            "default": 1e-08
          },
          "friction": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Friction",
            "default": 1.0
          },
          "friction_torsional": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Friction Torsional",
            "default": 0.005
          },
          "friction_rolling": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Friction Rolling",
            "default": 0.0001
          },
          "contact_dimension": {
            "type": "integer",
            "enum": [
              1,
              3,
              4,
              6
            ],
            "title": "Contact Dimension",
            "description": "1 frictionless; 3 sliding; 4 adds torsional; 6 adds rolling friction.",
            "default": 6
          },
          "contact_timeconst": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0001,
            "title": "Contact Timeconst",
            "default": 0.01
          },
